@model SimpleECommerce.Controllers.Response.ProductResponse

@{
    ViewData["title"] = "商品編集";
    ViewData["readOnly"] = false;
}

<h1>編集</h1>
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @await Html.PartialAsync("_ProductResponse", Model)
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">変更</button>
        <a asp-controller="Product" asp-action="Index" class="btn btn-secondary ms-2">キャンセル</a>
    </div>
</form>