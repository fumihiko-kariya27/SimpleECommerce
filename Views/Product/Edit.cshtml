@using SimpleECommerce.Domain.Catalog.Categories
@model SimpleECommerce.Controllers.Request.ProductRequest

@{
    ViewData["title"] = "商品編集";
}

<h1>編集</h1>
<form asp-controller="Product" asp-action="Edit" asp-route-category="" asp-route-productId="" method="post" enctype="multipart/form-data">
    <div class="form-group mb-3">
        <label asp-for="UploadFiles"></label>
        <input type="file" asp-for="UploadFiles" class="form-control mt-2" accept="image/jpeg" multiple />
    </div>
    <div class="form-group">
        <label asp-for="Category"></label>
        <select asp-for="Category" class="form-control"
                asp-items="Html.GetEnumSelectList<CategoryId>()" disabled ></select>
        <input type="hidden" asp-for="Category" />
    </div>
    <div class="form-group">
        <label asp-for="Id"></label>
        <input asp-for="Id" class="form-control" disabled />
        <input type="hidden" asp-for="Id" />
        <span asp-validation-for="Id" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Desc"></label>
        <input asp-for="Desc" class="form-control" />
        <span asp-validation-for="Desc" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">変更</button>
        <a asp-controller="Product" asp-action="Index" class="btn btn-secondary ms-2">キャンセル</a>
    </div>
</form>