@using SimpleECommerce.Controllers.Catalog
@model IEnumerable<ProductResponse>

@{
    ViewData["title"] = "商品一覧";
}

@section Scripts{
    <script src="~/js/products.js" defer></script>
    <script src="~/js/modal.js" defer></script>
}

@section Css{
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modal.css" asp-append-version="true" />
}

<div class="page-header">
    <h1 class="page-title">商品一覧</h1>
    <form asp-controller="Product" asp-action="Csv" method="get">
        <button type="submit" class="btn-download">CSVダウンロード</button>
    </form>
</div>
<div id="modal" class="modal">
    <div class="modal-content">
        <p id="modal-message"></p>
        <div class="modal-buttons">
            <button id="modal-yes" class="btn btn-danger">はい</button>
            <button id="modal-no" class="btn btn-secondary">いいえ</button>
        </div>
    </div>
</div>
<div id="purchase-modal" class="modal">
    <div class="modal-content purchase-modal-content">
        <h2 id="purchase-name"></h2>

        <p class="purchase-price">価格: <span id="purchase-price"></span></p>
        <p class="purchase-stock">在庫: <span id="purchase-stock"></span> 個</p>

        <div class="quantity-selector">
            <button id="qty-minus" class="qty-btn">−</button>
            <span id="purchase-quantity">1</span>
            <button id="qty-plus" class="qty-btn">＋</button>
        </div>

        <div class="modal-buttons">
            <button id="purchase-add" class="btn btn-primary">追加</button>
            <button id="purchase-cancel" class="btn btn-secondary">キャンセル</button>
        </div>
    </div>
</div>
<div class="product-grid">
@foreach (var p in Model)
{
    <div class="product-card">
        <div class="card-menu">
            <button class="menu-button" data-menu="@(p.Id)">:</button>
            <div class="menu-dropdown" id="menu-@(p.Id)">
                <a 
                    asp-controller="Product" 
                    asp-action="Edit" 
                    asp-route-category="@((int)p.Category)"
                    asp-route-productId="@(p.Id)"
                >
                編集
                </a>
                <a 
                    href="#"
                    class="delete-link"
                    data-name="@(p.Name)"
                    data-url="@Url.Action("Delete", "Product", new { category = (int)p.Category, productId = p.Id })">
                削除
                </a>
            </div>
        </div>
        <div class="product-image">
        @foreach (int seq in p.imageSequence)
        {
            <img 
                src="/product/image/@(p.Category)/@(p.Id)/@seq"
                alt="@p.Name"
                class="img-thumbnail"
                style="max-width: 200px;"
                onerror="this.src='/images/noimage.jpg';"
            />
        }
        </div>
        <div class="product-info">
            <h3 class="product-name">@p.Name</h3>
            <p class="product-description">@p.Desc</p>
            <p class="product-price">@p.Price.ToString("C0")</p>
            <p class="product-inventory">在庫数 @p.Inventory 個</p>
        </div>
        <div class="product-actions">
            <button 
                class="btn-buy"
                data-name="@p.Name"
                data-price="@p.Price"
                data-stock="@p.Inventory"
                data-id="@p.Id"
            >購入</button>
        </div>
    </div>
}
</div>
