@model IEnumerable<ProductResponse>

@{
    ViewData["title"] = "商品一覧";
}

@section Scripts{
    <script src="~/js/products.js" defer></script>
}

<div class="page-header">
    <h1 class="page-title">商品一覧</h1>
    <form asp-controller="Product" asp-action="Csv" method="get">
        <button type="submit" class="btn-download">CSVダウンロード</button>
    </form>
</div>
<div class="product-grid">
@foreach (var p in Model)
{
    <div class="product-card">
        <div class="card-menu">
            <button class="menu-button" data-menu="@(p.Id)">:</button>
            <div class="menu-dropdown" id="menu-@(p.Id)">
                <a 
                    asp-controller="Product" 
                    asp-action="Edit" 
                    asp-route-category="@(p.Category)"
                    asp-route-productId="@(p.Id)"
                >
                編集
                </a>
                <a 
                    asp-controller="Product" 
                    asp-action="Delete" 
                    asp-route-category="@(p.Category)"
                    asp-route-productId="@(p.Id)">
                削除
                </a>
            </div>
        </div>
        <div class="product-image">
            <img src="~/images/product/@(p.Category)/@(p.Id).jpg" alt="@(p.Name)" onerror="this.src='/images/noimage.jpg';" />
        </div>
        <div class="product-info">
            <h3 class="product-name">@p.Name</h3>
            <p class="product-description">@p.Description</p>
            <p class="product-price">@p.Price.ToString("C0")</p>
        </div>
    </div>
}
</div>
